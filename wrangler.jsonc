{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sleeper-league-bridge",
  "main": "worker.js",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  },
  "triggers": {
    "crons": [
      "0 */3 * * *"
    ]
  }
}
